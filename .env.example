# NodeSeek 多站点自动签到脚本环境变量配置示例
# 复制为 .env（青龙面板里直接加到「环境变量」即可）

# ========== 基础配置 ==========
NS_RANDOM=true

# ========== 账号配置（推荐）==========
# 格式：用户名1&密码1&用户名2&密码2
# Cookie 失效时，脚本会用真浏览器重新登录换 cookie
NS_USER_PASS=你的NodeSeek用户名1&你的NodeSeek密码1

# ========== 浏览器登录（2026-10 起的必需项）==========
#
# 登录必须用真浏览器（Turnstile + FingerprintJS 指纹 + security_token）。
# 有三种部署形态，选一种：
#
#  形态 A：全部在这台 VPS 上跑（最简单）
#          不用配 LOGIN_AGENT_URL，脚本会自己起本地浏览器登录。
#          前提：这台机器装了 patchright + chromium + xvfb（跑 install_vps.sh 即可）。
#
#  形态 B：青龙在 docker 里，浏览器登录放在宿主机（推荐，容器重建不丢环境）
#          LOGIN_AGENT_URL=http://172.17.0.1:3000
#
#  形态 C：浏览器登录放在另一台家宽/住宅 IP 的机器上
#          LOGIN_AGENT_URL=http://那台机器的IP:3000
#
# 注意：决定成败的是出口 IP 的“干净度”，不是 CPU 性能。
#       机房 IP 很可能过不了 Cloudflare —— 先跑 check_env.py 看结论。

LOGIN_AGENT_URL=
LOGIN_AGENT_TOKEN=与agent的AGENT_TOKEN保持一致

# 多台登录机器（配了它就不用 LOGIN_AGENT_URL，按账号固定分配，指纹更稳定）
# LOGIN_AGENT_URLS=http://ip1:3000,http://ip2:3000

# agent 登录失败后，是否还允许本机再试一次
LOGIN_LOCAL_FALLBACK=true

# 登录超时（秒），要等 Turnstile，别设太短
LOGIN_AGENT_TIMEOUT=240

# 本地浏览器是否用无头模式。默认 false（有头才过得了 CF）
# 真的想试无头：LOGIN_LOCAL_HEADLESS=true
# LOGIN_LOCAL_HEADLESS=false

# 浏览器引擎：camoufox（默认，实测能过 NodeSeek 的 CF） / patchright / playwright / auto
# AGENT_ENGINE=camoufox

# 给浏览器挂代理（家宽 IP 不好搞时，可以租住宅代理）
# AGENT_PROXY=http://user:pass@host:port

# 账号开了 2FA 时填 TOTP 密钥（Base32）
# NS_TOTP_SECRET=
# 多账号各开各的 2FA 时，按用户名分别配：
# NS_TOTP_SECRETS=alice:JBSWY3DPEHPK3PXP&bob:KRSXGZLOMFWWKZLT

# ========== Cookie 兜底（可选）==========
# 有手工 cookie 就先用手工的，失效了才去登录；多个用 & 分隔
# NS_COOKIE=session=xxx; pjwt=yyy&session=zzz; pjwt=www

# ========== 主动续期（推荐开启）==========
# NodeSeek 的登录 cookie 约 30 天过期。到期后重新登录，正常情况下不会
# 再要邮箱验证码（同一 profile，NodeSeek 记得这台设备）。
# 但为了「万一设备记忆失效」时也不至于签到中断，脚本会：
#   1) 记录 cookie 的到期时间
#   2) 剩余寿命不足这个天数时，提前主动换新一次
#   3) 万一真要邮箱验证码却拿不到 → 立刻推 Telegram 告警
# 设 0 = 关闭主动续期（只在 cookie 真失效时才登录）
NS_RENEW_BEFORE_DAYS=5

# ========== 让验证码也自动化（做到真正无人值守）==========
# 上面说过：首次在一台新机器上登录需要邮箱验证码。之后靠「记住设备」免掉。
# 万一设备记忆失效了，可以配下面的自动收码，让脚本自己收、自己填。
# 三种方式任选其一，都**不需要**把邮箱登录密码交给脚本（IMAP 那条除外，
# 它用的是邮箱授权码，可以单独申请、随时改）：
#
# 方式 A：验证码落地文件（推荐，最省事）
#   在邮箱里设一条转发规则，把邮件自动转到能写这个文件的脚本/webhook。
#   NS_CODE_FILE=/root/nodeseek-autosign/code.txt
#
# 方式 B：HTTP 取码
#   NS_CODE_URL=https://your-service.com/nodeseek/code
#   （返回纯文本验证码内容即可）
#
# 方式 C：IMAP 自动收信（需要邮箱授权码，不是登录密码）
#   NS_IMAP_HOST=imap.your-mail.com
#   NS_IMAP_PORT=993
#   NS_IMAP_USER=you@your-mail.com
#   NS_IMAP_PASS=邮箱授权码
#   NS_IMAP_FOLDER=INBOX
#   NS_IMAP_SENDER=nodeseek
#
# 等待验证码的最长秒数（默认 180）
# NS_CODE_TIMEOUT=180

# ========== 通知服务（可选）==========
# 不配也能正常签到，只是没有推送。配几个就推几个，会同时发。
# 所有渠道都在这一个文件里，不需要改代码。

# ---- Telegram ----
# 1) 找 @BotFather 发 /newbot，拿到 token（格式：<数字ID>:<35位字母数字>）
# 2) 先给 bot 随便发句话，再打开
#    https://api.telegram.org/bot<token>/getUpdates
#    里面的 "chat":{"id":<你的数字ID>} 就是 TG_USER_ID
# TG_BOT_TOKEN=
# TG_USER_ID=

# 服务器访问不了 api.telegram.org 时，二选一：
#   1) 用反代域名
# TG_API_HOST=https://tgapi.你的域名.com
#   2) 走本机代理
# TG_PROXY_HOST=127.0.0.1
# TG_PROXY_PORT=7890
#   代理需要密码时
# TG_PROXY_AUTH=user:pass
# 想发到超级群里的话题
# TG_THREAD_ID=2

# ---- 企业微信机器人 ----
# 群机器人 Webhook 地址里 key= 后面那串
# QYWX_KEY=

# ---- 钉钉机器人 ----
# DD_BOT_TOKEN=
# DD_BOT_SECRET=

# ---- 飞书机器人 ----
# FSKEY=

# ---- Bark（iOS）----
# BARK_PUSH=

# ---- Server酱 ----
# PUSH_KEY=

# ---- PushPlus（微信）----
# PUSH_PLUS_TOKEN=

# ---- 邮件 ----
# SMTP_SERVER=smtp.qq.com:465
# SMTP_SSL=true
# SMTP_EMAIL=you@qq.com
# SMTP_PASSWORD=邮箱授权码（不是登录密码）
# SMTP_NAME=NodeSeek

# 每条推送末尾附一句随机"一言"。国内服务器拉不到会慢 5 秒，建议关掉
# HITOKOTO=false

# 不想收到的推送标题，多个用回车分隔
# SKIP_PUSH_TITLE=

# ========== 旧方案（CloudFreed，默认完全关闭）==========
# 2026-10 起 signIn 接口要 x-integrity-token(FingerprintJS) + x-security-token，
# CloudFreed 只能给 Turnstile token，登录必然失败，所以默认不调用。
# 只有你明确还想试才打开下面这个开关，并填 API_KEY。
# ALLOW_CLOUDFREED=false
# CLOUDFREED_API_KEY=你的CloudFreed客户端密钥
# CLOUDFREED_BASE_URL=http://你的服务器IP:3000
# NS_SECURITY_TOKEN=
# NS_INTEGRITY_TOKEN=
