# 登录代理环境变量。复制为 .env 后修改：cp .env.example .env
# 调用方（青龙）必须带同样的 token
AGENT_TOKEN=改成一段随机字符串_比如_openssl_rand_hex_16

# 浏览器引擎：patchright / camoufox / playwright / auto
AGENT_ENGINE=patchright

# 是否无头运行。
# 【必须 false】Cloudflare 能识别 headless，实测无头模式下 Turnstile 永远过不去。
# 容器里由 entrypoint 自动套 Xvfb，所以设 false 也不会弹窗。
AGENT_HEADLESS=false

# 可选：这台机器的出口代理。机器本身就是家宽直连就留空
AGENT_PROXY=

# 账号开了 2FA 时填 TOTP secret（Base32），一般留空
AGENT_TOTP_SECRET=

# 数据目录（profile、cookie、截图）
AGENT_DATA_DIR=./data

# 同一时刻允许几个浏览器实例（1 台家宽机建议 1~2）
AGENT_MAX_CONCURRENCY=1
